<Window x:Class="HyperPOS.Desktop.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt" Width="520" Height="780" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="#F2F3F7">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="4,0,4,12">
            <TextBlock Text="Receipt" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="ReceiptSubTitle" Foreground="#737B8C" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E1E3E8" BorderThickness="1"
                CornerRadius="8" Padding="10">
            <FlowDocumentScrollViewer x:Name="ReceiptPreview" VerticalScrollBarVisibility="Auto"
                                      IsToolBarVisible="False" Background="White"/>
        </Border>
        <DockPanel Grid.Row="2" Margin="4,12,4,0">
            <Button Content="Close" Width="100" Height="40" DockPanel.Dock="Right"
                    Click="Close_Click" Background="White" BorderBrush="#DDE1E9"/>
            <Button Content="Print receipt" Width="135" Height="40" DockPanel.Dock="Right"
                    Margin="0,0,9,0" Click="Print_Click" Background="#20A45A"
                    Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </DockPanel>
    </Grid>
</Window>
