<Window x:Class="HyperPOS.Desktop.ProductSyncSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product sync settings" Width="500" Height="490" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#EFEFEF">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#25262A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#727783"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Connect product catalog" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Download the POS catalog and cache it locally for offline sales."
                       FontSize="12" Foreground="#777B83" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,10">
            <TextBlock Text="WEBSITE ROOT URL" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="BaseUrlBox" Height="40" Padding="10,8" FontSize="13"
                     Text="https://saraaboutique.com"/>
            <TextBlock Text="API KEY" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
            <PasswordBox x:Name="TokenBox" Height="40" Padding="10,8" FontSize="13"/>
            <TextBlock Text="A new key is required once on each computer. Leave it blank to keep the saved key."
                       FontSize="10" Foreground="#777B83" TextWrapping="Wrap" Margin="0,7,0,0"/>
            <Border Background="#FFFDF9" BorderBrush="#F0E9DC" BorderThickness="1"
                    CornerRadius="8" Padding="11" Margin="0,18,0,0">
                <TextBlock Text="Setup required on the web server: deploy the desktop POS catalog endpoint from the provided PHP project and set DESKTOP_POS_API_TOKEN in its environment. Use HTTPS; this key is stored encrypted for your Windows account."
                           FontSize="11" Foreground="#5D5C60" TextWrapping="Wrap"/>
            </Border>
            <TextBlock x:Name="ValidationText" Foreground="#C4434D" FontSize="11"
                       TextWrapping="Wrap" Margin="0,11,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="94" Height="40" Margin="0,0,9,0"
                    Click="Cancel_Click" Background="White" BorderBrush="#E8E7E9"/>
            <Button Content="Save &amp; sync" Width="125" Height="40"
                    Click="SaveAndSync_Click" Background="#20A45A" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
