<Window x:Class="HyperPOS.Desktop.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add product" Width="460" Height="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#EFEFEF">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7A8492"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Add product" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="Add an item to the local product catalog."
                       Foreground="#7A8492" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,22,0,14">
            <TextBlock Text="PRODUCT NAME" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource FormInput}"/>
            <TextBlock Text="CATEGORY" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="CategoryBox" Style="{StaticResource FormInput}"/>
            <TextBlock Text="SKU" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="SkuBox" Style="{StaticResource FormInput}"/>
            <TextBlock Text="BARCODE (OPTIONAL)" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="BarcodeBox" Style="{StaticResource FormInput}"/>
            <TextBlock Text="PRICE" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="PriceBox" Style="{StaticResource FormInput}"/>
            <TextBlock Text="OPENING STOCK" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="StockBox" Style="{StaticResource FormInput}" Text="0"/>
            <TextBlock x:Name="ValidationText" Foreground="#C4434D"
                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Height="42" Margin="0,0,10,0"
                    Click="Cancel_Click" Background="White" BorderBrush="#E8EAF0"/>
            <Button Content="Save product" Width="140" Height="42" Click="Save_Click"
                    Background="#20A45A" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
