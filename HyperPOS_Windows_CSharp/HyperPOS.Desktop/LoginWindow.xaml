<Window x:Class="HyperPOS.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saraa Boutique - POS Login"
        Width="920" Height="580" MinWidth="850" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#289B37"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42*"/>
            <ColumnDefinition Width="58*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Branding Panel -->
        <Border Grid.Column="0" Background="#54587E" Padding="35">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46" CornerRadius="12" Background="White" Margin="0,0,12,0">
                            <TextBlock Text="D" FontSize="26" FontWeight="Bold" Foreground="#54587E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Saraa Boutique" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Point of Sale System" FontSize="12" Foreground="#D1D5DB"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Middle Description -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
                    <TextBlock Text="Welcome back to Store POS" FontSize="22" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Fast, reliable offline &amp; online billing for Sarees, Readymade collections and Boutique items." FontSize="13" Foreground="#E5E7EB" TextWrapping="Wrap"/>
                    
                    <Border Background="#484C6F" CornerRadius="10" Padding="14,12" Margin="0,25,0,0">
                        <StackPanel>
                            <TextBlock Text="STORE LOCATION" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock Text="● India - Store Terminal 1" FontSize="13" FontWeight="SemiBold" Foreground="#86EFAC" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer info -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Saraa Boutique © 2026" FontSize="11" Foreground="#9CA3AF"/>
                    <TextBlock Text="Support: +91 99406 19605" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Login Form Panel -->
        <Border Grid.Column="1" Background="White" Padding="45,35">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Cashier Sign-In" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Select your cashier profile or enter your credentials to open the register." FontSize="12" Foreground="#6B7280" Margin="0,4,0,24"/>

                    <!-- Quick Cashier Selector -->
                    <TextBlock Text="SELECT CASHIER PROFILE" FontSize="11" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CashierSelector" Height="42" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,18" SelectionChanged="CashierSelector_SelectionChanged">
                        <ComboBoxItem Content="Praveen Balaji (Super Admin)"/>
                        <ComboBoxItem Content="Saraa Boutique (Store Admin)"/>
                        <ComboBoxItem Content="Balaji (Employee)"/>
                        <ComboBoxItem Content="Parthiban (Employee)"/>
                        <ComboBoxItem Content="Jeyasri Selvaraj (Super Admin)"/>
                        <ComboBoxItem Content="Dharshini (Super Admin)"/>
                        <ComboBoxItem Content="Sathish (Employee)"/>
                    </ComboBox>

                    <!-- Email Field -->
                    <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10,0" Margin="0,0,0,16">
                        <TextBox x:Name="EmailBox" Text="praveenbalajimindzmap@gmail.com" BorderThickness="0" Background="Transparent" Height="40" FontSize="13" VerticalContentAlignment="Center" Foreground="#1F2937"/>
                    </Border>

                    <!-- Password Field -->
                    <TextBlock Text="Password / PIN" FontSize="12" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="10,0" Margin="0,0,0,16">
                        <PasswordBox x:Name="PasswordBox" BorderThickness="0" Background="Transparent" Height="40" FontSize="13" VerticalContentAlignment="Center" Foreground="#1F2937" KeyDown="PasswordBox_KeyDown"/>
                    </Border>

                    <!-- Error Alert Banner -->
                    <Border x:Name="ErrorBanner" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ " FontSize="13" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ErrorMessageText" Text="Incorrect password. Please enter the valid credentials."
                                       FontSize="12" FontWeight="SemiBold" Foreground="#DC2626"
                                       TextWrapping="Wrap" MaxWidth="320" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Sign In Action Button -->
                    <Button x:Name="LoginButton" Content="Open POS Register →" Click="LoginButton_Click" Height="46" Style="{StaticResource PrimaryBtn}" Margin="0,0,0,14"/>

                    <!-- Fast Quick Access -->
                    <Button Content="⚡ Fast Enter as Super Admin (Praveen Balaji)" Click="QuickEnter_Click" Height="36" Style="{StaticResource SecondaryBtn}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
