<Window x:Class="HyperPOS.Desktop.HeldOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hold order list" Width="920" Height="580" MinWidth="750" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- Modern ultra-slim scrollbar -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="false"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#CBD5E1" CornerRadius="2" Margin="0,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="false"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Hold current strip (collapsed unless needed) -->
            <RowDefinition Height="Auto"/>
            <!-- Search & Filter bar -->
            <RowDefinition Height="*"/>
            <!-- Orders Grid / Empty State -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Close button (circle) -->
            <Button Content="✕" DockPanel.Dock="Right" Width="32" Height="32"
                    Click="Close_Click" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" Foreground="#64748B" FontSize="13"
                    Style="{StaticResource FlatButton}"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Hold order list" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Select a hold order to view or resume"
                           Foreground="#6B7280" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Optional Hold Current Bar -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="8" Margin="0,0,0,12"
                Visibility="{Binding ElementName=HoldCurrentButton, Path=IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <Button x:Name="HoldCurrentButton" Content="Hold current cart" DockPanel.Dock="Right"
                        Click="HoldCurrent_Click" Background="#FFF3E2" Foreground="#EA580C"
                        BorderBrush="#FED7AA" BorderThickness="1"
                        Padding="14,7" FontWeight="SemiBold" Style="{StaticResource FlatButton}"/>
                <TextBox x:Name="CustomerNameBox" Height="36" Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1"
                         ToolTip="Customer name for this hold order"
                         Text="Walking Customer" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>

        <!-- Search & Filter Row -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search box with magnifying glass -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="8" Padding="12,0" Height="42" Margin="0,0,10,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="🔍" FontSize="13" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                 FontSize="12.5" Foreground="#1F2937" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="Search by Order No., Customer Name or Phone..."
                                   FontSize="12" Foreground="#94A3B8"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Sort dropdown button -->
            <Button Grid.Column="1" Height="42" Padding="16,0"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    Style="{StaticResource FlatButton}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⇅  Latest First  ▾" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Content Area: Orders Grid or Empty State -->
        <Grid Grid.Row="3">
            <!-- Empty state illustration -->
            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="20" Visibility="Collapsed">
                <!-- Hourglass in circle -->
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="⌛" FontSize="26" Foreground="#64748B"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No hold orders found"
                           FontSize="15" FontWeight="Bold" Foreground="#1E293B"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Hold orders will appear here when you hold a cart"
                           FontSize="12" Foreground="#64748B"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- DataGrid when orders exist -->
            <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="None" Background="White" BorderBrush="#E2E8F0"
                      RowHeight="54" ColumnHeaderHeight="42" SelectionMode="Single"
                      MouseDoubleClick="OrdersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- Visual Customer Badge Column -->
                    <DataGridTemplateColumn Header="PARKED CART / CUSTOMER" Width="2.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Border Background="{Binding BadgeColor}" CornerRadius="16" Width="32" Height="32" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding CustomerInitials}" FontSize="12" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CustomerName}" FontSize="12.5" FontWeight="Bold" Foreground="#1F2937"/>
                                        <TextBlock Text="{Binding TimeAgo, StringFormat='Held {0}'}" FontSize="11" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Items Badge -->
                    <DataGridTemplateColumn Header="ITEMS IN CART" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding ItemCount, StringFormat='🛒 {0} Items'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Amount -->
                    <DataGridTemplateColumn Header="TOTAL" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Total, StringFormat=₹{0:N2}}" FontSize="13.5" FontWeight="Bold" Foreground="#16A34A"
                                           VerticalAlignment="Center" Margin="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Date / Time -->
                    <DataGridTextColumn Header="HELD TIMESTAMP" Binding="{Binding HeldAt, StringFormat={}{0:dd MMM yyyy, hh:mm tt}}" Width="1.8*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="2,12,2,0">
            <TextBlock x:Name="CountText" Foreground="#737B8C" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Delete selected" Click="Delete_Click" Margin="0,0,8,0"
                        Padding="14,8" Background="White" Foreground="#DC2626"
                        BorderBrush="#FECACA" Style="{StaticResource FlatButton}"/>
                <Button Content="Resume selected" Click="Resume_Click" Padding="16,8"
                        Background="#289B37" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Style="{StaticResource FlatButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
