<Window x:Class="HyperPOS.Desktop.HeldOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hold Orders" Width="900" Height="600" MinWidth="720" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="#F7F8FC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Button Content="×" DockPanel.Dock="Right" Width="30" Height="30"
                    Click="Close_Click" Background="White" BorderBrush="#E5E7EB"
                    Foreground="#6B7280" FontSize="17"/>
            <StackPanel>
                <TextBlock Text="Hold Orders" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Find a saved cart and resume it, or hold the current cart for later."
                           Foreground="#737B8C" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E5EC" BorderThickness="1"
                CornerRadius="9" Padding="9" Margin="0,16,0,12">
            <DockPanel>
                <Button x:Name="HoldCurrentButton" Content="Hold current cart" DockPanel.Dock="Right"
                        Click="HoldCurrent_Click" Background="#FFF3E2" Foreground="#B86C00"
                        BorderThickness="0" Padding="13,8" FontWeight="SemiBold"/>
                <TextBox x:Name="CustomerNameBox" Height="36" Padding="9,7"
                         VerticalContentAlignment="Center"
                         ToolTip="Optional customer or order name"
                         Text="Walking Customer"/>
            </DockPanel>
        </Border>
        <TextBox x:Name="SearchBox" Grid.Row="2" Height="36" Padding="9,7" Margin="0,0,0,10"
                 VerticalContentAlignment="Center" ToolTip="Search held orders by customer or amount"
                 TextChanged="SearchBox_TextChanged"/>
        <DataGrid x:Name="OrdersGrid" Grid.Row="3" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="None" Background="White" BorderBrush="#E2E5EC"
                  RowHeight="56" ColumnHeaderHeight="42" SelectionMode="Single"
                  MouseDoubleClick="OrdersGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <!-- Visual Customer Badge Column -->
                <DataGridTemplateColumn Header="PARKED CART / CUSTOMER" Width="2.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <Border Background="{Binding BadgeColor}" CornerRadius="18" Width="36" Height="36" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding CustomerInitials}" FontSize="13" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CustomerName}" FontSize="13" FontWeight="Bold" Foreground="#1F2937"/>
                                    <TextBlock Text="{Binding TimeAgo, StringFormat='Held {0}'}" FontSize="11" Foreground="#9CA3AF"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Items Badge -->
                <DataGridTemplateColumn Header="ITEMS IN CART" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding ItemCount, StringFormat='🛒 {0} Items'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Amount -->
                <DataGridTemplateColumn Header="TOTAL" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Total, StringFormat=₹{0:N2}}" FontSize="14" FontWeight="Bold" Foreground="#16A34A"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Date / Time -->
                <DataGridTextColumn Header="HELD TIMESTAMP" Binding="{Binding HeldAt, StringFormat={}{0:dd MMM yyyy, hh:mm tt}}" Width="1.8*"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="2,12,2,0">
            <TextBlock x:Name="CountText" Foreground="#737B8C" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Delete selected" Click="Delete_Click" Margin="0,0,8,0"
                        Padding="14,9" Background="White" Foreground="#B5474F"
                        BorderBrush="#E7D5D7"/>
                <Button Content="Resume selected" Click="Resume_Click" Padding="15,9"
                        Background="#20A45A" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
