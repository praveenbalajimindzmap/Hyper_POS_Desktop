<Window x:Class="HyperPOS.Desktop.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saraa Boutique - Customer Display"
        Width="1024" Height="700" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="28,0">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#54587E" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="S" FontSize="20" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Saraa Boutique" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="● Store: India · Welcome!" FontSize="11" Foreground="#10B981"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#064E3B" CornerRadius="20" Padding="14,6">
                        <TextBlock x:Name="StatusBadge" Text="● Live Checkout Active" FontSize="12" FontWeight="SemiBold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN BODY (2 Columns) -->
        <Grid Grid.Row="1" Margin="28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58*"/>
                <ColumnDefinition Width="42*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: CART ITEMS -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,14,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="YOUR SHOPPING BAG" FontSize="13" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="ItemCountText" Text="0 Items" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CartItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="10" Margin="0,0,0,10" Padding="14,10" BorderBrush="#334155" BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="{Binding LineTotal, StringFormat=₹{0:N2}}" DockPanel.Dock="Right"
                                                       FontSize="16" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <Border DockPanel.Dock="Right" Background="#334155" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Quantity, StringFormat=Qty: {0}}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Product.Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Product.SkuCategoryLine}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- TOTAL SUMMARY STRIP -->
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Margin="0,12,0,0" Padding="16,12" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="Subtotal Price" Foreground="#94A3B8" FontSize="13"/>
                                <TextBlock x:Name="SubtotalText" Text="₹0.00" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                            </DockPanel>
                            <DockPanel Grid.Row="1">
                                <TextBlock Text="Special Savings Discount" Foreground="#34D399" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DiscountSavingsText" Text="₹0.00" DockPanel.Dock="Right" Foreground="#34D399" FontWeight="Bold"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: PAYMENT & DYNAMIC UPI QR CODE -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Margin="14,0,0,0" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TOTAL PAYABLE BANNER -->
                    <Border Grid.Row="0" Background="#166534" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL PAYABLE AMOUNT" FontSize="11" FontWeight="Bold" Foreground="#BBF7D0" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TotalPayableText" Text="₹0.00" FontSize="34" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- DYNAMIC QR CODE DISPLAY -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="14" BorderBrush="#334155" BorderThickness="1" Padding="16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Scan &amp; Pay with Any UPI App" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            
                            <Border Background="White" CornerRadius="12" Padding="12" HorizontalAlignment="Center">
                                <Image x:Name="UpiQrImage" Width="190" Height="190" Stretch="Uniform"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Border Background="#334155" CornerRadius="6" Padding="8,4" Margin="3,0">
                                    <TextBlock Text="Google Pay" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#334155" CornerRadius="6" Padding="8,4" Margin="3,0">
                                    <TextBlock Text="PhonePe" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#334155" CornerRadius="6" Padding="8,4" Margin="3,0">
                                    <TextBlock Text="Paytm" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#334155" CornerRadius="6" Padding="8,4" Margin="3,0">
                                    <TextBlock Text="BHIM" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- FOOTER MESSAGE -->
                    <TextBlock Grid.Row="2" Text="✨ Thank you for choosing Saraa Boutique!" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STRIP -->
        <Border Grid.Row="2" Background="#0B1120" Padding="28,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="Customer Support: +91 99746 92496 · Exchange policy: 7 Days" FontSize="11" Foreground="#64748B"/>
                <TextBlock Text="Saraa Boutique Smart Retail System" DockPanel.Dock="Right" FontSize="11" Foreground="#64748B"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
