<Window x:Class="HyperPOS.Desktop.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take Payment - Saraa Boutique" Width="560" Height="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style x:Key="PayMethodBtn" TargetType="RadioButton">
            <Setter Property="GroupName" Value="PaymentMethodGroup"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5"
                                CornerRadius="8" Padding="14,10" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#334155" x:Name="Text"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E6F7EB"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#289B37"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Text" Property="Foreground" Value="#166534"/>
                                <Setter TargetName="Text" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#289B37"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickCashBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Complete Payment" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Select payment method, collect tender, and issue receipt."
                           Foreground="#64748B" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- AMOUNT DUE BANNER -->
        <Border Grid.Row="1" Background="#166534" CornerRadius="12" Padding="20,14" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TOTAL PAYABLE" FontSize="11" FontWeight="Bold" Foreground="#BBF7D0"/>
                    <TextBlock x:Name="TotalText" Text="₹0.00" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Customer" FontSize="11" Foreground="#BBF7D0" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="CustomerDisplayHeader" Text="Walking Customer" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- BODY SCROLL -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <!-- PAYMENT METHODS -->
                <TextBlock Text="PAYMENT METHOD" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,14">
                    <RadioButton x:Name="PayCashRadio" Content="💵 Cash" Style="{StaticResource PayMethodBtn}" IsChecked="True" Checked="PaymentMethod_Checked"/>
                    <RadioButton x:Name="PayUpiRadio" Content="📱 Dynamic UPI / QR" Style="{StaticResource PayMethodBtn}" Checked="PaymentMethod_Checked"/>
                    <RadioButton x:Name="PayCardRadio" Content="🎟️ Voucher" Style="{StaticResource PayMethodBtn}" Checked="PaymentMethod_Checked"/>
                    <RadioButton x:Name="PayCreditRadio" Content="🏷️ Store Credit" Style="{StaticResource PayMethodBtn}" Checked="PaymentMethod_Checked"/>
                    <RadioButton x:Name="PayChequeRadio" Content="📄 Cheque" Style="{StaticResource PayMethodBtn}" Checked="PaymentMethod_Checked"/>
                    <RadioButton x:Name="PaySplitRadio" Content="⚖️ Split Pay" Style="{StaticResource PayMethodBtn}" Checked="PaymentMethod_Checked"/>
                </WrapPanel>

                <!-- DYNAMIC UPI QR CONTAINER (Visible when UPI selected) -->
                <Border x:Name="UpiQrContainer" Visibility="Collapsed" Background="#F1F5F9" BorderBrush="#CBD5E1"
                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="6" HorizontalAlignment="Center">
                            <Image x:Name="UpiQrImage" Width="120" Height="120" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="Dynamic UPI Payment QR" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                            <TextBlock Text="Exact amount auto-embedded. Customer can scan with GPay, PhonePe, Paytm, or BHIM."
                                       FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <Border Background="#DCFCE7" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                <TextBlock Text="● Soundbox Verification Simulated" FontSize="10.5" FontWeight="SemiBold" Foreground="#166534"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SPLIT PAYMENT CONTAINER (Visible when Split selected) -->
                <Border x:Name="SplitPayContainer" Visibility="Collapsed" Background="#F1F5F9" BorderBrush="#CBD5E1"
                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="CASH PORTION" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="SplitCashBox" Height="36" FontSize="14" Padding="8,6" Text="0.00" TextChanged="SplitBox_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="UPI / DIGITAL PORTION" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBox x:Name="SplitUpiBox" Height="36" FontSize="14" Padding="8,6" Text="0.00" TextChanged="SplitBox_TextChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CUSTOMER DETAILS & PHONE -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="CUSTOMER NAME" FontSize="10.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBox x:Name="CustomerNameBox" Height="38" FontSize="13" Padding="10,8" Text="Walking Customer"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="MOBILE NUMBER (WHATSAPP)" FontSize="10.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBox x:Name="CustomerPhoneBox" Height="38" FontSize="13" Padding="10,8" ToolTip="10-digit mobile number for WhatsApp receipt"/>
                    </StackPanel>
                </Grid>

                <!-- CASH TENDER SECTION (When cash or default) -->
                <StackPanel x:Name="CashTenderSection">
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock x:Name="AmountLabel" Text="CASH RECEIVED" FontSize="10.5" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="Quick Tender" DockPanel.Dock="Right" FontSize="10.5" Foreground="#64748B"/>
                    </DockPanel>

                    <!-- QUICK CASH TENDER PILLS -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="[Exact]" Style="{StaticResource QuickCashBtn}" Click="QuickCashExact_Click"/>
                        <Button Content="+₹100" Style="{StaticResource QuickCashBtn}" Click="QuickCashAdd_Click" Tag="100"/>
                        <Button Content="+₹500" Style="{StaticResource QuickCashBtn}" Click="QuickCashAdd_Click" Tag="500"/>
                        <Button Content="+₹1,000" Style="{StaticResource QuickCashBtn}" Click="QuickCashAdd_Click" Tag="1000"/>
                        <Button Content="+₹2,000" Style="{StaticResource QuickCashBtn}" Click="QuickCashAdd_Click" Tag="2000"/>
                    </StackPanel>

                    <TextBox x:Name="AmountBox" Height="42" FontSize="18" FontWeight="Bold" Padding="12,8"
                             TextChanged="AmountBox_TextChanged"/>

                    <Border Background="#F1F5F9" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock Text="Change Due to Customer" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ChangeText" Text="₹0.00" DockPanel.Dock="Right"
                                       FontSize="17" FontWeight="Bold" Foreground="#166534"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- WHATSAPP E-RECEIPT OPTION -->
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                    <CheckBox x:Name="SendWhatsAppCheckBox" IsChecked="True" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬  Send Free WhatsApp E-Receipt to Customer" FontSize="12" FontWeight="SemiBold" Foreground="#166534"/>
                        </StackPanel>
                    </CheckBox>
                </Border>

                <TextBlock x:Name="ValidationText" Foreground="#DC2626" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <Button Content="Cancel [Esc]" Width="110" Height="42" Click="Cancel_Click"
                        Background="White" BorderBrush="#CBD5E1" Foreground="#475569" FontWeight="SemiBold"
                        Cursor="Hand"/>
                <Button x:Name="ConfirmButton" Content="Complete Sale [Alt+S]" DockPanel.Dock="Right" Height="42"
                        Click="Confirm_Click" Background="#289B37" Foreground="White"
                        BorderThickness="0" FontWeight="Bold" FontSize="14" Padding="20,0"
                        Cursor="Hand"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
