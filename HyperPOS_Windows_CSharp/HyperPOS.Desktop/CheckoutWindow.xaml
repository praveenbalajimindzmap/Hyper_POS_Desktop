<Window x:Class="HyperPOS.Desktop.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Take payment" Width="440" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#EFEFEF">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#20252D"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Complete sale" FontSize="23" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Text="Choose how the customer paid. Payment is recorded locally."
                   TextWrapping="Wrap" Foreground="#7A8492" FontSize="12" Margin="0,7,0,22"/>
        <Border Grid.Row="2" Background="White" BorderBrush="#E8EAF0" BorderThickness="1"
                CornerRadius="10" Padding="16" Margin="0,0,0,20">
            <DockPanel>
                <TextBlock Text="Amount due" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TotalText" DockPanel.Dock="Right" FontSize="20"
                           FontWeight="Bold" Foreground="#20A45A"/>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="3">
            <TextBlock Text="PAYMENT METHOD" FontSize="10" FontWeight="Bold"
                       Foreground="#7A8492" Margin="0,0,0,7"/>
            <ComboBox x:Name="PaymentMethodBox" Height="42" FontSize="14"
                      SelectionChanged="PaymentMethodBox_SelectionChanged">
                <ComboBoxItem Content="Cash" IsSelected="True"/>
                <ComboBoxItem Content="Card"/>
                <ComboBoxItem Content="UPI / digital"/>
                <ComboBoxItem Content="Gift card"/>
            </ComboBox>
            <TextBlock Text="CUSTOMER NAME" FontSize="10" FontWeight="Bold"
                       Foreground="#7A8492" Margin="0,15,0,7"/>
            <TextBox x:Name="CustomerNameBox" Height="38" FontSize="13" Padding="10,7"
                     Text="Walking Customer"/>
            <TextBlock x:Name="AmountLabel" Text="CASH RECEIVED" FontSize="10"
                       FontWeight="Bold" Foreground="#7A8492" Margin="15,15,0,7"/>
            <TextBox x:Name="AmountBox" Height="42" FontSize="17" Padding="10,7"
                     TextChanged="AmountBox_TextChanged"/>
            <DockPanel Margin="0,12,0,0">
                <TextBlock Text="Change due" Foreground="#7A8492"/>
                <TextBlock x:Name="ChangeText" Text="₹0.00" DockPanel.Dock="Right"
                           FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock x:Name="ValidationText" Foreground="#C4434D"
                       FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Height="42" Margin="0,0,10,0"
                    Click="Cancel_Click" Background="White" BorderBrush="#E8EAF0"/>
            <Button x:Name="ConfirmButton" Content="Complete sale" Width="150" Height="42"
                    Click="Confirm_Click" Background="#20A45A" Foreground="White"
                    BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
