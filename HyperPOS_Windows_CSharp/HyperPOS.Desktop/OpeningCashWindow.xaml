<Window x:Class="HyperPOS.Desktop.OpeningCashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opening Cash" Width="480" Height="550" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7F8FC">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Button Content="×" DockPanel.Dock="Right" Width="30" Height="30"
                    Click="Cancel_Click" Background="White" BorderBrush="#E5E7EB"
                    Foreground="#6B7280" FontSize="17"/>
            <TextBlock Text="Opening Cash" FontSize="22" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Text="Enter the starting cash amount for this shift."
                   Foreground="#737B8C" FontSize="12" Margin="0,7,0,20"/>
        <Border x:Name="InputPanel" Grid.Row="2" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="10" Padding="15">
            <StackPanel>
                <TextBlock Text="OPENING CASH AMOUNT" FontSize="10" FontWeight="Bold"
                           Foreground="#72798A" Margin="0,0,0,8"/>
                <DockPanel>
                    <TextBlock Text="₹" FontSize="22" FontWeight="SemiBold"
                               Foreground="#4049A4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="AmountBox" Height="45" FontSize="21"
                             VerticalContentAlignment="Center" Padding="8,4"
                             TextChanged="AmountBox_TextChanged"/>
                </DockPanel>
                <TextBlock Text="Quick cash" FontSize="11" Foreground="#747B8D"
                           Margin="0,15,0,7"/>
                <UniformGrid Columns="5">
                    <Button Content="₹5" Tag="5" Click="QuickAmount_Click" Margin="0,0,5,0"
                            Padding="7,8" Background="#F4F5FA" BorderBrush="#E2E4EF"/>
                    <Button Content="₹10" Tag="10" Click="QuickAmount_Click" Margin="0,0,5,0"
                            Padding="7,8" Background="#F4F5FA" BorderBrush="#E2E4EF"/>
                    <Button Content="₹20" Tag="20" Click="QuickAmount_Click" Margin="0,0,5,0"
                            Padding="7,8" Background="#F4F5FA" BorderBrush="#E2E4EF"/>
                    <Button Content="₹50" Tag="50" Click="QuickAmount_Click" Margin="0,0,5,0"
                            Padding="7,8" Background="#F4F5FA" BorderBrush="#E2E4EF"/>
                    <Button Content="₹100" Tag="100" Click="QuickAmount_Click"
                            Padding="7,8" Background="#F4F5FA" BorderBrush="#E2E4EF"/>
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border x:Name="SavedPanel" Grid.Row="2" Visibility="Collapsed"
                Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="10" Padding="18">
            <StackPanel>
                <TextBlock Text="OPENING CASH AMOUNT" FontSize="10" FontWeight="Bold"
                           Foreground="#72798A"/>
                <TextBlock x:Name="SavedAmountText" FontSize="28" FontWeight="Bold"
                           Foreground="#20834D" Margin="0,7,0,15"/>
                <DockPanel Margin="0,0,0,7">
                    <TextBlock Text="Business day" Foreground="#737B8C"/>
                    <TextBlock x:Name="SavedBusinessDateText" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="Shift opened" Foreground="#737B8C"/>
                    <TextBlock x:Name="SavedOpenedAtText" DockPanel.Dock="Right" FontWeight="SemiBold"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#DBEAFE"
                BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,14,0,0"
                VerticalAlignment="Top">
            <TextBlock Text="This amount is the starting cash balance for this shift. It is included in the expected cash at day end."
                       Foreground="#3F506A" FontSize="11" TextWrapping="Wrap"/>
        </Border>
        <StackPanel Grid.Row="4">
            <TextBlock x:Name="ValidationText" Foreground="#C4434D" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="40" Margin="0,0,9,0"
                        Click="Cancel_Click" Background="White" BorderBrush="#DDE1E9"/>
                <Button x:Name="CloseButton" Content="Close" Width="100" Height="40"
                        Visibility="Collapsed" Click="Cancel_Click"
                        Background="White" BorderBrush="#DDE1E9"/>
                <Button x:Name="SaveButton" Content="Save opening cash" Width="155" Height="40"
                        Click="Save_Click" Background="#20A45A" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
